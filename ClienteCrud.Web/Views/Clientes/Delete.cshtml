@model ClienteCrud.Domain.Entities.Cliente

@{
    ViewData["Title"] = "Eliminar cliente";
}

<a asp-action="Index" class="back-link">
    <i data-lucide="arrow-left"></i>
    Regresar
</a>

<div class="page-header">
    <div class="page-header-copy">
        <h1>
            <i data-lucide="trash-2"></i>
            Eliminar cliente
        </h1>
        <p>Confirma esta acción antes de continuar.</p>
    </div>
</div>

<div class="ui-card form-card">
    <div class="ui-card-body">
        <div class="danger-banner">
            <i data-lucide="info"></i>
            <p>¿Seguro que deseas eliminar este cliente? Esta acción no se puede deshacer.</p>
        </div>

        <div class="detail-grid">
            <div class="detail-item">
                <div class="label"><i data-lucide="user"></i> @Html.DisplayNameFor(model => model.Nombre)</div>
                <div class="value">@Model.Nombre</div>
            </div>
            <div class="detail-item">
                <div class="label"><i data-lucide="user-round"></i> @Html.DisplayNameFor(model => model.Apellido)</div>
                <div class="value">@Model.Apellido</div>
            </div>
            <div class="detail-item">
                <div class="label"><i data-lucide="mail"></i> @Html.DisplayNameFor(model => model.Email)</div>
                <div class="value">@Model.Email</div>
            </div>
            <div class="detail-item">
                <div class="label"><i data-lucide="phone"></i> @Html.DisplayNameFor(model => model.Telefono)</div>
                <div class="value">@Model.Telefono</div>
            </div>
            <div class="detail-item full">
                <div class="label"><i data-lucide="map-pin"></i> @Html.DisplayNameFor(model => model.Direccion)</div>
                <div class="value">@Model.Direccion</div>
            </div>
            <div class="detail-item full">
                <div class="label"><i data-lucide="info"></i> @Html.DisplayNameFor(model => model.FechaRegistro)</div>
                <div class="value">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="mt-1">
            <input type="hidden" asp-for="Id" />
            <div class="form-actions">
                <a asp-action="Index" class="btn-ui btn-secondary-ui">
                    <i data-lucide="x"></i>
                    Cancelar
                </a>
                <button type="submit" class="btn-ui btn-danger-ui">
                    <i data-lucide="trash-2"></i>
                    Eliminar
                </button>
            </div>
        </form>
    </div>
</div>
